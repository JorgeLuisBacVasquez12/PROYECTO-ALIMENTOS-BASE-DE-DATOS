NODE_ENV=development
HOST=127.0.0.1
PORT=4001
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Supabase > Connect > Session pooler (or transaction pooler). URL-encode the password.
DATABASE_URL=postgresql://postgres.PROJECT:REPLACE_PASSWORD@POOLER_HOST:5432/postgres
DATABASE_SSL=true
# If your project requires a CA, paste its PEM using literal \n separators. Never disable TLS verification.
DATABASE_SSL_CA=
DATABASE_SSL_CA_FILE=
DB_POOL_MAX=10
SUPABASE_URL=https://PROJECT.supabase.co
# Backend only. Never use VITE_ for this key.
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_BACKEND_SECRET_KEY
TRUST_PROXY_HOPS=0
UPLOAD_MAX_MB=10
IMPORT_MAX_ROWS=50000
IMPORT_MAX_COLUMNS=150
IMPORT_TTL_MINUTES=30
REPORT_MAX_ROWS=50000
APP_TIMEZONE=America/Guatemala

# Optional: initial administrator, consumed only by configurar/admin:create.
ADMIN_EMAIL=
ADMIN_DISPLAY_NAME=
ADMIN_PASSWORD=
